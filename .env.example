# ----------------------------------------------------------------------------
# Variables d'environnement — Jean Ba Paysagiste
# Copier ce fichier en ".env.local" (dev) et configurer sur Vercel (prod).
# ----------------------------------------------------------------------------

# Clé API Resend pour l'envoi des e-mails du formulaire de contact.
# Créer un compte sur https://resend.com puis générer une clé API.
# Sans cette clé, le formulaire fonctionne mais les e-mails ne sont PAS envoyés
# (la demande est seulement journalisée côté serveur).
RESEND_API_KEY=

# Adresse e-mail qui RECEVRA les demandes de devis.
CONTACT_TO_EMAIL=contact@jeanba-paysagiste.fr

# Expéditeur des e-mails. Doit être un domaine vérifié sur Resend.
# Tant que le domaine n'est pas vérifié, utiliser "onboarding@resend.dev".
CONTACT_FROM_EMAIL="Jean Ba Paysagiste <onboarding@resend.dev>"
